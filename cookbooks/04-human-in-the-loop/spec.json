{
  "name": "cookbook-04-human-in-the-loop",
  "input_schema": {
    "type": "object",
    "additionalProperties": true,
    "title": "hitl_Input"
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": true,
    "title": "hitl_Output"
  },
