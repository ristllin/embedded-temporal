build/
.venv/
# Generated code is regenerated by gen_host.sh / gen_nanopb.sh, not committed…
gen/
nanopb/gen/
*.o
*.a
*.pb.cc
*.pb.h
*.pb.c
.DS_Store

# …except the hand-written IProtoCodec adapter (a source deliverable that
# happens to live under gen/ alongside the generated headers it wraps).
!gen/
!gen/proto_codec.h
gen/host/
gen/nanopb/

# …and the committed DEVICE subset: small + pinned so the PlatformIO build
# needs no protoc/venv; wire-verified by test_nanopb_device_conformance.
!gen/nanopb_worker_adapter.h
!gen/nanopb_worker_adapter.cpp
!gen/nanopb-device/
!gen/nanopb-device/**
