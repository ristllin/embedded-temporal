# build artifacts
build/
**/build/
.pio/
**/.pio/
*.o
*.a
*.elf
*.bin

# generated protobuf (regenerated via proto/gen_host.sh / gen_nanopb.sh)
proto/gen/host/
proto/gen/nanopb/

# python
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.egg-info/
dist/

# device provisioning secrets — NEVER commit (generated at flash time)
firmware/src/mwf_prov_secrets.h

# cookbook run evidence (generated by run_local.sh)
cookbooks/*/evidence/

# os
.DS_Store

# local secrets (never commit) — MISTRAL_API_KEY etc.
# .env* also covers .env.local / .env.production style names.
.env
.env*
*.env

# editors / IDEs
.vscode/
.idea/
*.swp
*~

# local sanitization denylist for tools/release/verify_sanitized.sh
.scrub-denylist

# generated single-library layout (tools/release/build_lib.sh default output)
out/
